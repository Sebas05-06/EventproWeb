# Variables que se cargan en Vercel (Settings > Environment Variables). No subas valores reales.
# Las no secretas (APP_ENV, APP_DEBUG, SESSION_DRIVER, etc.) ya están en vercel.json.
APP_KEY=              # genéralo con: php artisan key:generate --show
APP_URL=https://tu-proyecto.vercel.app
DB_CONNECTION=mysql   # o pgsql, según tu base externa
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
